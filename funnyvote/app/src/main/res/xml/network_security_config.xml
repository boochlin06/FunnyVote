<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- MASVS-NETWORK-1: 全域禁止明文 HTTP 通訊，強制 TLS 1.2+，只信任系統預設 CA -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
