rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 用戶資料庫：本人才可修改自己資料
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /favorites/{pollId} {
        allow read, write: if isOwner(userId);
      }
      match /voted_polls/{pollId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 投票主文檔
    match /polls/{pollId} {
      // 公開投票允許免登入讀取，私人投票限登入讀取
      allow read: if resource.data.security == "00" || isAuthenticated();
      // 僅限本人發起，建立時作者 ID 必須綁定自己的 UID，且標題不可為空並限制長度
      allow create: if isAuthenticated() 
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 100;
      // 僅限作者修改描述與結束時間，或一般用戶投票計數遞增 (防竄改作者、建立時間、安全性與其他敏感欄位)
      allow update: if isAuthenticated() && (
        // 情況 A：作者本人編輯，不可變更 authorId、pollId、createdAt
        (resource.data.authorId == request.auth.uid
         && request.resource.data.authorId == resource.data.authorId
         && request.resource.data.pollId == resource.data.pollId
         && request.resource.data.createdAt == resource.data.createdAt)
        ||
        // 情況 B：一般用戶投票，僅允許遞增 totalVotes
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalVotes'])
         && request.resource.data.totalVotes > resource.data.totalVotes)
      );
      // 僅限作者本人刪除
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // 投票選項
      match /options/{optionId} {
        allow read: if true;
        // 建立：作者本人，或該投票允許用戶新增選項
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/polls/$(pollId)).data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/polls/$(pollId)).data.isUserCanAddOption == true
        );
        // 更新：作者本人，或投票時僅允許遞增 voteCount
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/polls/$(pollId)).data.authorId == request.auth.uid ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voteCount']) &&
           request.resource.data.voteCount > resource.data.voteCount)
        );
        allow delete: if isAuthenticated() && get(/databases/$(database)/documents/polls/$(pollId)).data.authorId == request.auth.uid;
      }

      // 一人一票防刷票子集合：利用 !exists 防止同一帳號多投
      match /voters/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) && !exists(/databases/$(database)/documents/polls/$(pollId)/voters/$(userId));
        allow update, delete: if false; // 投完票不可修改或撤回
      }
    }

    // 零信任密碼保護集合：路徑為 sha256(pollId + password)
    // 禁止任何 list 查詢，只允許精確 Hash 命中時讀取
    match /secure_polls/{secretHash} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated();
    }
  }
}
